#!/bin/bash
# shellcheck disable=SC1090,SC1091

case $- in
*i*) ;; # Interactive
*) return ;;
esac

# ---------------------------- Environment ---------------------------

# Non-login shells (e.g. a nested `bash`) may lack the shared environment
if [ -z "${DOTFILES:-}" ] && [ -f ~/.profile ]; then
  . ~/.profile
fi

# Not exported, so child scripts calling `cd` are not affected
CDPATH=".:$HOME:$REPOS/github.com:$GHREPOS:$DOTFILES"

# ------------------------------ History -----------------------------

# Append to the history file instead of overwriting it on exit, and save
# each command right away so parallel shells do not lose history
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+"; $PROMPT_COMMAND"}"

HISTSIZE=100000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
HISTTIMEFORMAT='%F %T  '

# ------------------------------ Aliases -----------------------------

unalias -a
command -v vim >/dev/null 2>&1 && alias vi=vim
alias ls='ls -h --color=auto'

# ----------------------------- Functions ----------------------------

# Clone a GitHub repo into $REPOS/github.com/<user>/<name> (or cd into it)
clone() {
  local repo user name dir
  repo=${1:?usage: clone [user/]name}
  repo=${repo#https://github.com/}
  repo=${repo#git@github.com:}
  repo=${repo%.git}
  case $repo in
  */*) user=${repo%%/*} ;;
  *) user=${GITUSER:-$USER} ;;
  esac
  name=${repo##*/}
  dir=$REPOS/github.com/$user/$name
  if [ ! -d "$dir" ]; then
    mkdir -p -- "${dir%/*}" &&
      gh repo clone "$user/$name" "$dir" -- --recurse-submodules || return
  fi
  cd -- "$dir" || return
}

# ------------------------ Local configuration -----------------------

for local_config in ~/.bash_personal ~/.bash_private ~/.bash_work; do
  [ -f "$local_config" ] && . "$local_config"
done
unset local_config

# ---------------------- Completion and prompt -----------------------

if [ -z "${BASH_COMPLETION_VERSINFO:-}" ] && [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi

# Two-line prompt: a blank line, user@host:dir(branch),
# then $ on its own line. Colors are ANSI, so they follow the terminal theme
__ps1() {
  local P='$' dir=${PWD##*/} B \
    r='\[\e[31m\]' u='\[\e[33m\]' h='\[\e[34m\]' w='\[\e[35m\]' \
    b='\[\e[36m\]' p='\[\e[34m\]' g='\[\e[90m\]' x='\[\e[0m\]'

  [ "$EUID" -eq 0 ] && P='#' && u=$r && p=$r
  [ "$PWD" = / ] && dir=/
  [ "$PWD" = "$HOME" ] && dir='~'

  B=$(git branch --show-current 2>/dev/null)
  [ -n "$B" ] && [ "$dir" = "$B" ] && B=.
  case $B in master | main) b=$r ;; esac
  [ -n "$B" ] && B="$g($b$B$g)"

  PS1="\n$u\\u$g@$h\\h$g:$w$dir$B\n$p$P$x "
}

PROMPT_COMMAND="${PROMPT_COMMAND:+"$PROMPT_COMMAND; "}__ps1"
