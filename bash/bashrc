#!/bin/bash
# shellcheck disable=SC1090,SC1091

case $- in
*i*) ;; # Interactive
*) return ;;
esac

# ----------------------- Environment variables ----------------------

export PAGER=less
export LESSHISTFILE=/dev/null

export EDITOR=vim
export VISUAL=vim

export GOPATH="$HOME/.local/share/go"
export GOBIN="$HOME/.local/bin"

export REPOS="$HOME/repos"
export GITUSER=lucasherediadv
export GHREPOS="$REPOS/github.com/$GITUSER"

export DOTFILES="$GHREPOS/dotfiles"
export SCRIPTS="$DOTFILES/scripts"

export CDPATH=".:$HOME:$REPOS/github.com:$GHREPOS:$DOTFILES"

# ------------------------------- $PATH ------------------------------

pathappend() {
  local arg
  for arg in "$@"; do
    test -d "$arg" || continue
    PATH=${PATH//":$arg:"/:}
    PATH=${PATH/#"$arg:"/}
    PATH=${PATH/%":$arg"/}
    export PATH="${PATH:+"$PATH:"}$arg"
  done
}

pathappend "$SCRIPTS" "$HOME/.local/bin"

# ----------------------------- Readline -----------------------------

set -o vi
bind 'set show-all-if-ambiguous on'
bind 'set completion-ignore-case on'

# --------------------------- Shell options --------------------------

shopt -s dotglob
shopt -s extglob
shopt -s globstar
shopt -s checkwinsize

# ------------------------------ History -----------------------------

shopt -s histappend
export HISTSIZE=500000
export HISTFILESIZE=100000
export HISTCONTROL=ignoreboth

# ------------------------------ Aliases -----------------------------

unalias -a
alias vi='$EDITOR'
alias clear='clear -x'
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first --classify=auto'
fi

# ------------------------ Local configuration -----------------------

for local_config in ~/.bash_personal ~/.bash_private ~/.bash_work; do
  [[ -f $local_config ]] && . "$local_config"
done
unset local_config

# ---------------------- Completion and prompt -----------------------

if [[ -z ${BASH_COMPLETION_VERSINFO:-} && -f /usr/share/bash-completion/bash_completion ]]; then
  . /usr/share/bash-completion/bash_completion
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi
