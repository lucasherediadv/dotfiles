# Readline configuration, shared by every program that uses it
# (bash, python, psql, gdb, ...). See readline(3).
#
# Kept close to the defaults on purpose: completion, history search and
# paste behave as on any other system. Only vi mode and a few
# cosmetic or vi-mode-specific settings are changed.

# Keep the system defaults (terminal key sequences, 8-bit input)
$include /etc/inputrc

# Vi mode. Defaults that still apply: Esc to command mode, / and ? to
# search the history, Tab Tab to list completions
set editing-mode vi

# Wait less for the rest of a key sequence after Esc (default 500ms),
# so switching to command mode is instant
set keyseq-timeout 50

# No terminal bell
set bell-style none

# Ctrl-L clears the screen in insert mode too, as in every default shell
# (vi-insert leaves it unbound; vi-command already has it)
$if mode=vi
set keymap vi-insert
"\C-l": clear-screen
$endif
