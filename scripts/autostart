#!/bin/sh

# Launches the Sway session programs on their workspaces, creating the
# tmux session first (or reusing it if it already exists).

tmux has-session -t =0 2>/dev/null || tmux new-session -d -s 0

swaymsg "workspace 1; exec foot tmux attach-session -t =0; \
         workspace 2; exec firefox; \
         workspace 1"
