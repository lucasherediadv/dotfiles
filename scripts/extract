#!/bin/sh
set -eu

require() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'Error: missing command: %s\n' "$1" >&2
    exit 127
  }
}

_extract() {
  if [ "$#" -eq 1 ] && [ -f "$1" ]; then
      case "$1" in
        *.tar.bz2) require tar; tar xjf -- "$1" ;;
        *.tar.gz) require tar; tar xzf -- "$1" ;;
        *.tar.xz) require tar; tar xf -- "$1" ;;
        *.bz2) require bunzip2; bunzip2 -- "$1" ;;
        *.rar) require rar; rar x -- "$1" ;;
        *.gz) require gunzip; gunzip -- "$1" ;;
        *.tar) require tar; tar xf -- "$1" ;;
        *.tbz2) require tar; tar xjf -- "$1" ;;
        *.tgz) require tar; tar xzf -- "$1" ;;
        *.zip) require unzip; unzip -- "$1" ;;
        *.Z) require uncompress; uncompress -- "$1" ;;
        *.7z) require 7z; 7z x -- "$1" ;;
        *.xz) require unxz; unxz -- "$1" ;;
        *) printf "Error: '%s' cannot be extracted\n" "$1" >&2; return 2 ;;
      esac
  else
    printf 'Usage: extract filename\n' >&2
    return 2
  fi
}

_extract "$@"
