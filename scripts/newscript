#!/bin/bash

# creates a new script in my scripts collection

if [[ -z ${SCRIPTS:-} ]]; then
  echo "Error: SCRIPTS environment variable is not set." >&2
  exit 1
fi

if [[ ! -d $SCRIPTS ]]; then
  echo "Error: SCRIPTS directory '$SCRIPTS' does not exist." >&2
  exit 1
fi

name=$1

if [ $# -eq 0 ]; then
  # ask for name of script
  echo "Please provide a name for the script:"
  read -r name
fi

if [[ -z $name ]]; then
  echo "Error: Script name cannot be empty." >&2
  exit 1
fi

target_path="$SCRIPTS/$name"

if [[ -e $target_path ]]; then
  echo "Error: File '$target_path' already exists." >&2
  exit 1
fi

touch "$target_path"
chmod +x "$target_path"
echo "#!/bin/bash" >"$target_path"
