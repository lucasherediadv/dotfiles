#!/bin/sh
set -eu

buffer_dir=${XDG_RUNTIME_DIR:-"${HOME:-/tmp}/.cache"}/dotfiles
mkdir -p "$buffer_dir"
chmod 700 "$buffer_dir"
buf=$buffer_dir/buf
: >"$buf"
chmod 600 "$buf"

while IFS= read -r line; do
  printf '%s\n' "$line" >>"$buf"
  printf '%s\n' "$line"
done

if command -v wl-copy >/dev/null 2>&1; then
  wl-copy <"$buf"
fi
