{
  "position": "bottom",
  "height": 30,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 4,

  "modules-left": ["sway/workspaces"],
  "modules-right": ["cpu", "memory", "clock"],

  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },

  "memory": {
    "interval": 5,
    "format": "MEM {percentage}%",
    "states": {
      "warning": 75,
      "critical": 90
    }
  }
}
