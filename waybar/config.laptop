{
  "layer": "top",
  "position": "bottom",
  /* Bar + 1px border + 4px margin on each side (drawn in style.css, leaves room for the shadow) */
  "height": 40,
  "margin-top": 0,
  "margin-left": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "modules-left": [
    "sway/workspaces",
    "hyprland/workspaces",
  ],
  "modules-right": [
    "cpu",
    "memory",
    /* "temperature", */
    "battery",
    /* "user", */
    "clock"
  ],
  /* CPU */
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "tooltip": false,
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  /* Memory */
  "memory": {
    "interval": 5,
    "format": "MEM {percentage}%",
    "tooltip": false,
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  /* Uptime. The default format would print the username, hence the override. */
  "user": {
    "interval": 30,
    "tooltip": false,
    "open-on-click": true,
    "format": "UP {work_H}:{work_M}"
  },
  "temperature": {
    "interval": 10,
    "format": "TEMP {temperatureC}°C",
    "warning-threshold": 75,
    "critical-threshold": 90,
    "tooltip": false 
  },
  "battery": {
    "interval": 30,
    "format": "BAT {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": false
  },
  "clock": {
    "tooltip": false
  }
}
