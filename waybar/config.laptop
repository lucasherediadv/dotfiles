{
  "layer": "top",
  "position": "bottom",
  "height": 30,
  "margin-top": 0,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 4,
  "modules-left": [
    "sway/workspaces",
  ],
  "modules-right": [
    "cpu",
    "memory",
    /* "temperature", */
    "battery",
    "user",
    "clock"
  ],
  /* CPU */
  "cpu": {
    "interval": 5,
    "format": "CPU {usage}%",
    "tooltip": true,
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  /* Memory */
  "memory": {
    "interval": 5,
    "format": "MEM {percentage}%",
    "tooltip": true,
    "states": {
      "warning": 75,
      "critical": 90
    }
  },
  /* Uptime. The default format would print the username, hence the override. */
  "user": {
    "interval": 30,
    "format": "UP {work_H}:{work_M}"
  },
  "temperature": {
    "interval": 10,
    "format": "TEMP {temperatureC}°C",
    "warning-threshold": 75,
    "critical-threshold": 90,
    "tooltip": true
  },
  "battery": {
    "interval": 30,
    "format": "BAT {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "tooltip": true
  }
}
